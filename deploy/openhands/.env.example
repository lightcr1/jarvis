# Copy to .env with scripts/prepare_openhands.sh. Never commit the real file.
OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas:1.20.0@sha256:213f1c9fbb92277aff2b5f2247af0fd788ec2e8bea5e2e5a88b33af83ee382a6
OPENHANDS_BIND_IP=127.0.0.1
OPENHANDS_PORT=8000
OPENHANDS_STATE_DIR=/opt/jarvis-openhands/state
# Host port for the canvas edge (canvas: http://<host>:OPENHANDS_EDGE_PORT/canvas).
# The agent itself never publishes a host port; port 8000 is used by jarvis.service.
OPENHANDS_EDGE_PORT=8001
# Mount only this repository; never point at a directory containing other projects.
OPENHANDS_JARVIS_PROJECT_DIR=/opt/jarvis-openhands/projects/jarvis
OPENHANDS_MEMORY_LIMIT=8g
OPENHANDS_CPU_LIMIT=4
# Generate a dedicated random request-only token; never reuse an admin/model/GitHub token.
JARVIS_AGENT_REQUEST_TOKEN=replace-with-random-request-only-token
RUNPOD_NETWORK_NAME=runpod_default
# Allowlist-Proxy: kontrollierter Internet-Ausgang fuer den Agenten (nur pypi.org,
# files.pythonhosted.org, github.com, codeload/raw/objects.githubusercontent.com, api.github.com).
PROXY_URL=http://allowlist-proxy:3128
# Allowlist-Proxy: Quell-IP fuer ausgehende Verbindungen (runpod_default-IP des Proxy-Containers).
# Mit 'docker network inspect runpod_default' ermitteln.
EGRESS_IP=172.21.0.9
OPENHANDS_JARVIS_RUNTIME_DIR=/opt/jarvis-openhands/runtime
OPENHANDS_PYUSER_DIR=/opt/jarvis-openhands/pylocal

# Phase 6: GitHub-Downloads im Agenten-Proxy (0 = gesperrt, GitHub nur via Gateway).
ALLOW_GITHUB=0
