# Beispiel-Konfiguration fuer den Autonomy-Loop.
# Kopieren nach /home/media/jarvis-openhands/autonomy/autonomy-loop.env
# (oder per AUTONOMY_LOOP_ENV auf einen anderen Pfad zeigen).
#
# Reihenfolge: Default (siehe scripts/agent/autonomy_loop.py, DEFAULT_CONFIG)
# < diese Datei < Prozess-Umgebung. Prozess-Umgebung gewinnt.
# Alle Werte sind optional; die hier gezeigten sind die Defaults.

# --- Endpunkte ---
CONTROLLER_BASE=https://10.10.40.100:8443
OPENHANDS_BASE=http://10.10.40.100:8001
JARVIS_BASE=http://10.10.40.100:8100

# TLS: CA der selbst erzeugten runpod-tls/server.crt. Leer = CERT_NONE-Fallback
# mit Warnung im Log. Empfohlen: Pfad setzen und Verifikation aktivieren.
CONTROLLER_CA_FILE=

# --- Pfade (installationsspezifisch) ---
STATE_PATH=/home/media/jarvis-openhands/autonomy/autonomy-state.json
LOG_PATH=/home/media/jarvis-openhands/autonomy/autonomy-loop.log
ENV_RUNPOD=/home/media/runpod/.env
ENV_JARVIS=/home/media/jarvis.env
AUTONOMY_SWITCH=/home/media/jarvis-openhands/projects/jarvis/config/autonomy.json
WORKSPACE_REPO=/projects/jarvis
WORKTREE_REPO_PATH=/home/media/jarvis-openhands/projects/jarvis

# --- Zeitsteuerung / Budget ---
COOLDOWN_SECONDS=150
USER_BUSY_SECONDS=90
HEARTBEAT_INTERVAL=60
MAX_ITERATIONS=120
MAX_ITERATIONS_SMALL=40
MAX_ITERATIONS_MEDIUM=80
MAX_PARALLEL_ROUNDS=2
KEEP_FINISHED_CONVERSATIONS=10
STUCK_CYCLES=10
AGENT_NETWORK_MODE=isolated
# GPU-Kosten pro Stunde fuer die Kostenschaetzung im Rundenbericht (4.2; 0 = aus).
GPU_COST_PER_HOUR=0
WORKTREE_MAX_AGE_SECONDS=86400

# --- OpenHands-Condenser ---
CONDENSER_MAX_SIZE=60
CONDENSER_KEEP_FIRST=2
