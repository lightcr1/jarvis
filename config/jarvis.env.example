# =============================================================================
# JARVIS — Environment Variables (TLS / scripts/deploy_local.sh flow)
# =============================================================================
# This template is for the scripts/deploy_local.sh / update_local.sh /
# rollback_local.sh flow, which serves HTTPS on :443 with a self-signed (or
# your own) TLS certificate, and reads its config from /etc/jarvis/config.env.
#
# If you installed with scripts/install.sh instead (plain HTTP on :8000,
# /etc/jarvis/jarvis.env), use config/prod.env.example — the two flows use
# different config filenames on purpose so they can't be confused for each
# other on the same host.
#
#   sudo cp config/jarvis.env.example /etc/jarvis/config.env
#   sudo chown root:jarvis /etc/jarvis/config.env
#   sudo chmod 640 /etc/jarvis/config.env
#   # Edit /etc/jarvis/config.env and fill in all REQUIRED values
#   sudo ./scripts/deploy_local.sh
#
# The systemd unit loads this file via EnvironmentFile=/etc/jarvis/config.env
# =============================================================================

# =============================================================================
# CORE
# =============================================================================

# REQUIRED — set before deploying. Used to issue guest/device bearer tokens.
JARVIS_PASSPHRASE=

# REQUIRED — Change these from defaults before first boot.
JARVIS_DEFAULT_ADMIN_USERNAME=admin
JARVIS_DEFAULT_ADMIN_PASSWORD=

# OPTIONAL — Set to 1 to immediately block all write and dangerous actions.
JARVIS_EMERGENCY_STOP=0

# =============================================================================
# NETWORK / TLS — read by the jarvis.service unit deploy_local.sh installs
# =============================================================================

JARVIS_HOST=0.0.0.0
JARVIS_PORT=443
JARVIS_TLS_CERT_FILE=/etc/jarvis/tls/fullchain.pem
JARVIS_TLS_KEY_FILE=/etc/jarvis/tls/privkey.pem

# =============================================================================
# ADMIN DATA INTEGRITY — opt-in strictness for scripts/check_admin_data_integrity.sh
# =============================================================================
# deploy_local.sh seeds these to 0 (disabled) the first time it writes this
# file, so behavior is explicit rather than silently strict. Set any of them
# to 1 to make check_admin_data_integrity.sh (run by rollback_local.sh) fail
# the deploy/rollback instead of just warning.

# JARVIS_INTEGRITY_FAIL_ON_ORPHANS=0
# JARVIS_INTEGRITY_FAIL_ON_ADMIN_LOCKOUT=0
# JARVIS_INTEGRITY_FAIL_ON_DUPLICATE_MEMBERSHIPS=0

# Where admin_settings.json lives — used by check_admin_data_integrity.sh and
# the backup/restore scripts.
# JARVIS_ADMIN_SETTINGS_PATH=/var/lib/jarvis/admin_settings.json

# =============================================================================
# AI PROVIDERS
# =============================================================================

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# REQUIRED for BYOK (per-user API key) encryption at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JARVIS_SECRET_KEY=

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

JARVIS_HA_BASE_URL=
JARVIS_HOME_ASSISTANT_TOKEN=

PROXMOX_BASE_URL=
PROXMOX_API_TOKEN=

GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PAT=
