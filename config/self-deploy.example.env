# Beispiel fuer den host-seitigen Self-Deploy-Loop (Plan 5.3).
# Kopieren nach z.B. /home/media/jarvis-openhands/autonomy/self-deploy.env
# und anpassen. Der Loop laeuft per Cron und reagiert nur auf den Marker.

# Compose-Dateien relativ zu SELF_DEPLOY_WORKDIR:
SELF_DEPLOY_COMPOSE_FILES="deploy/docker-compose.yml deploy/docker-compose.override.yml"
SELF_DEPLOY_SERVICE=jarvis
SELF_DEPLOY_IMAGE=ghcr.io/lightcr1/jarvis-app:latest
# Entweder bauen oder ziehen:
SELF_DEPLOY_BUILD=1
# SELF_DEPLOY_PULL=1
SELF_DEPLOY_STATE_FILE=/var/lib/jarvis/self_deploy_state
JARVIS_HEALTH_URL=http://127.0.0.1:8100/health
# Wo liegen die Compose-Dateien? (Arbeitsverzeichnis des Loops)
SELF_DEPLOY_WORKDIR=/home/media/jarvis-openhands/projects/jarvis
