name: Autonomy trigger

on:
  schedule:
    # Alle 6 Stunden prüfen, ob eine autonome Verbesserungsrunde ansteht.
    - cron: "17 */6 * * *"
  workflow_dispatch:

permissions:
  contents: read
  issues: write

jobs:
  ensure-round:
    name: Ensure open autonomy round issue
    runs-on: ubuntu-latest
    steps:
      - name: Open autonomy issue if none is open
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Only one open round at a time. The owner stops autonomous work by
          # closing the issue or removing the label; Jarvis closes it when done.
          open="$(gh issue list --repo "$GITHUB_REPOSITORY" --label autonomy --state open --json number -q 'length' 2>/dev/null || echo 0)"
          if [ "${open:-0}" -gt 0 ]; then
            echo "Autonomy round already open (${open}) - nothing to do."
            exit 0
          fi
          body="$(cat <<'EOF'
          Autonome Verbesserungsrunde für Jarvis.

          Arbeite nach AGENTS.md: wähle die wertvollsten Verbesserungen (Code, Tests,
          Doku, Architektur, Dependency-Hygiene), bündle sie in wenige PRs gegen `dev`,
          und dokumentiere am Ende die Session in `docs/ACTIVITY_LOG.md`.

          Regeln:
          - Kleine, sichere Fixes direkt umsetzen; große Änderungen vorher vorschlagen.
          - Keine Beschäftigungstherapie: nur Arbeit mit echtem Wert.
          - Schließe dieses Issue, wenn die Runde abgeschlossen ist.
          EOF
          )"
          created_url="$(gh issue create --repo "$GITHUB_REPOSITORY" --title "Autonome Verbesserungsrunde" --body "$body" --label autonomy 2>/dev/null || true)"
          number="$(printf '%s' "$created_url" | sed -nE 's#.*/([0-9]+)$#\1#p')"
          if [ -z "${number:-}" ]; then
            echo "ERROR: could not create the autonomy round issue." >&2
            exit 1
          fi
          echo "Opened autonomy round issue #$number"
